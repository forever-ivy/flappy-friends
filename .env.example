# Docker Compose / 容器内 PocketBase 配置
GAME_PORT=8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=replace-with-a-long-random-password

# 本地前端开发（npm run dev）时指向 PocketBase 地址；
# 留空则使用 window.location.origin（生产同域部署不需要设置）。
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Umami（站长流量分析，可选）。两项都填才会在构建产物里注入 script。
# 详见 deploy/MONITORING.md
# VITE_UMAMI_SCRIPT_URL=https://stats.hyunlix.top/script.js
# VITE_UMAMI_WEBSITE_ID=

# Google Search Console 站点验证（可选）。填 Console 给出的 content 值即可。
# 详见 deploy/SEO.md
# VITE_GOOGLE_SITE_VERIFICATION=
